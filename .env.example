# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file. It's already in .gitignore.

# --- SEC EDGAR -----------------------------------------------------------
# SEC requires a descriptive User-Agent with a real name + contact email
# on every request to data.sec.gov. See:
# https://www.sec.gov/search-filings/edgar-application-programming-interfaces
SEC_USER_AGENT="Your Name your-email@example.com"

# --- Supabase (used by later ingestion/dashboard steps, not by the raw
#     fetch_*.py scripts in src/data/ yet) --------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: server-side / GitHub Actions only. Never expose to a
# public dashboard or commit to the repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- CoinGecko -------------------------------------------------------------
# Free public API needs no key. Set this only if you upgrade to a paid
# CoinGecko plan (Pro) and want to use the pro API host/header.
# COINGECKO_API_KEY=
